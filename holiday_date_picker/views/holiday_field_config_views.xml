<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_holiday_field_config_tree" model="ir.ui.view">
        <field name="name">holiday.field.config.tree</field>
        <field name="model">holiday.field.config</field>
        <field name="arch" type="xml">
            <list string="Holiday Fields" editable="bottom">
                <field name="model_id"/>
                <field name="field_id"/>
            </list>
        </field>
    </record>

    <record id="view_holiday_field_config_form" model="ir.ui.view">
        <field name="name">holiday.field.config.form</field>
        <field name="model">holiday.field.config</field>
        <field name="arch" type="xml">
            <form string="Holiday Field Configuration">
                <sheet>
                    <group>
                        <field name="model_id"/>
                        <field name="field_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_holiday_field_config" model="ir.actions.act_window">
        <field name="name">Holiday Fields Configuration</field>
        <field name="res_model">holiday.field.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_holiday_field_config" name="Holiday Fields" parent="menu_holiday_root" action="action_holiday_field_config" sequence="20"/>
</odoo>
