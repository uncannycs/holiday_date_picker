<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_holiday_date_tree" model="ir.ui.view">
        <field name="name">holiday.date.tree</field>
        <field name="model">holiday.date</field>
        <field name="arch" type="xml">
            <list string="Holidays" editable="bottom">
                <field name="name"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <record id="view_holiday_date_form" model="ir.ui.view">
        <field name="name">holiday.date.form</field>
        <field name="model">holiday.date</field>
        <field name="arch" type="xml">
            <form string="Holiday">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_holiday_date" model="ir.actions.act_window">
        <field name="name">Holidays</field>
        <field name="res_model">holiday.date</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_holiday_root" name="Holidays" parent="sale.menu_sale_config" sequence="100"/>
    <menuitem id="menu_holiday_date" name="Holidays" parent="menu_holiday_root" action="action_holiday_date" sequence="10"/>
</odoo>
